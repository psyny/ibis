# App
APP_ENV=development
LOG_LEVEL=info

# Database (Railway's postgres:// URLs are accepted too)
DATABASE_URL=postgresql://ibis:ibis@localhost:5432/ibis

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Migrations
RUN_MIGRATIONS_ON_STARTUP=false

# JWT
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
# Sliding sessions: signed out after this many hours without using the app (90 days);
# tokens older than JWT_REFRESH_AFTER_HOURS are renewed automatically when used.
JWT_EXPIRATION_HOURS=2160
JWT_REFRESH_AFTER_HOURS=24

# Max size of a user's transfer QR image (data URL), in KB
MAX_QR_IMAGE_KB=1024
